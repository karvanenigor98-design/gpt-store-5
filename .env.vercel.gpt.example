# Скопируй в Vercel → Settings → Environment Variables (Production + Preview)
# Минимум для лендинга GPT STORE на первом деплое

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Production URL (актуальный проект):
NEXT_PUBLIC_APP_URL=https://gpt-store-5.vercel.app
NEXT_PUBLIC_GPT_STORE_URL=https://gpt-store-5.vercel.app
NEXT_PUBLIC_SPOTIFY_STORE_URL=https://gpt-store-5.vercel.app/spotify

# Guest checkout: тариф → email → оплата → письмо со ссылкой в заказ/чат
GPT_GUEST_CHECKOUT=1
NEXT_PUBLIC_GPT_GUEST_CHECKOUT=1

# Я.Метрика GPT STORE (не /spotify). Домен: gpt-store-5.vercel.app
# NEXT_PUBLIC_GPT_STORE_YM_ID=109765207
# Я.Метрика Spotify/Subs (/spotify). Отдельный счётчик, тот же домен
# NEXT_PUBLIC_SUBS_STORE_YM_ID=109609539
